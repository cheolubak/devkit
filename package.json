{
  "name": "eslint-workspace",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint:ox lint lint:root",
    "lint:root": "eslint .",
    "lint:ox": "oxlint",
    "lint:es": "turbo run lint lint:root",
    "lint:fix": "oxlint --fix && turbo run lint -- --fix && eslint . --fix",
    "devbak": "node packages/devkit-cli/dist/bin.js",
    "publish:packages": "pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.76.0",
    "jest": "^30.4.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.76.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.3.0",
    "turbo": "2.10.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
