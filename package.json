{
  "name": "eslint-workspace",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint && eslint .",
    "lint:ox": "oxlint",
    "lint:es": "eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "devbak": "node packages/devkit-cli/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.76.0",
    "jest": "^30.4.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.76.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.3.0",
    "turbo": "2.10.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
