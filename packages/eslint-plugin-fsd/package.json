  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "^16.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
