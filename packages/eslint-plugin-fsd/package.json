    "eslint-plugin-react-hooks": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "@next/eslint-plugin-next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0"
  }
}
