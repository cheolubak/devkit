{
  "name": "@devbak/vitest-config",
  "version": "0.1.0",
  "description": "프론트엔드/Node 프로젝트 공용 Vitest 설정 (빌드 없음, ESM)",
  "license": "MIT",
  "keywords": ["vitest", "vitest-config", "nextjs"],
  "type": "module",
  "exports": {
    "./next": "./next.js",
    "./node": "./node.js"
  },
  "files": ["next.js", "node.js"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": "^2.1.0 || ^3.0.0",
    "jsdom": "^25.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": { "optional": true }
  }
}
