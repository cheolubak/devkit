{
  "name": "@devbak/eslint-config-nest",
  "version": "0.1.0",
  "description": "NestJS 백엔드용 ESLint 공유 설정 (ESLint 10 flat config 전용, 타입 인식 + zod DTO 검증)",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "nestjs",
    "typescript-eslint",
    "zod"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "eslint-plugin-zod": "^4.0.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-zod": "^4.9.0",
    "typescript-eslint": "^8.65.0",
    "zod": "^4.4.3"
  }
}
