{
  "name": "@cheolubak/devkit-cli",
  "version": "0.3.0",
  "description": "devkit 표준이 적용된 프로젝트를 생성하는 CLI",
  "license": "MIT",
  "keywords": ["scaffold", "template", "cli", "nestjs", "nextjs"],
  "type": "module",
  "bin": {
    "devbak": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "templates"],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheolubak/devkit.git",
    "directory": "packages/devkit-cli"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
